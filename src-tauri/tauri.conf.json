{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Overseer",
  "version": "../package.json",
  "identifier": "com.opnay.overseer",
  "build": {
    "beforeBuildCommand": "pnpm build:desktop",
    "beforeDevCommand": "pnpm dev:tauri:frontend",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self'; img-src 'self' data: https: http:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "devCsp": "default-src 'self'; connect-src 'self' http://127.0.0.1:1420 ws://127.0.0.1:1420; img-src 'self' data: https: http:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "externalBin": ["binaries/overseer-server"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "targets": ["app"],
    "macOS": {
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM1QkY3NkY2MkUxMjJGMTIKUldRU0x4SXU5bmEveFhoN3AzRDZGK1NNbXJxRUNJa05Fc0tRUkJxOHY5cGZpL2gzcnZsTjhJQ0QK",
      "endpoints": ["https://github.com/opnay/overseer/releases/latest/download/latest.json"]
    }
  }
}
