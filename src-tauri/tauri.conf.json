{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Overseer",
  "version": "0.1.0",
  "identifier": "com.opnay.overseer",
  "build": {
    "beforeBuildCommand": "pnpm build",
    "beforeDevCommand": "pnpm dev:tauri:frontend",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "center": true,
        "height": 800,
        "label": "main",
        "minHeight": 560,
        "minWidth": 760,
        "resizable": true,
        "title": "Overseer",
        "width": 1200
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "devCsp": "default-src 'self'; connect-src 'self' http://127.0.0.1:1420 ws://127.0.0.1:1420; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "targets": ["app"]
  }
}
